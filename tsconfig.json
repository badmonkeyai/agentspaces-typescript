{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "strict": true,
    "outDir": "build",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@agentspaces/client": [
        "./src/index.ts"
      ],
      "@agentspaces/client/node": [
        "./src/node/index.ts"
      ],
      "@agentspaces/ordered": [
        "./packages/ordered/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "demo/**/*.ts"
  ]
}
